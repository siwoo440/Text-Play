{
  "name": "mate-text-play",
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "description": "Mate Verse와 연결되는 로컬 우선 텍스트 게임 프로그램",
  "scripts": {
    "test": "vitest",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node scripts/run-desktop-e2e.mjs",
    "desktop:dev": "vite --config vite.desktop.config.ts --host 127.0.0.1 --port 1420",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:verify-assets": "node scripts/verify-desktop-assets.mjs",
    "tauri:dev": "tauri dev",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "tauri build --bundles nsis"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "2.0.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.1"
  }
}
